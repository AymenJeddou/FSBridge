# Copy to .env.local and fill in your Supabase project values
VITE_SUPABASE_URL=https://your-project.supabase.co
# Same public anon key for both (client.ts reads PUBLISHABLE, chatbot/admin read ANON)
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_ANON_KEY=your-anon-key
# Set to true to run with built-in mock data and no Supabase
VITE_FORCE_MOCK=false
